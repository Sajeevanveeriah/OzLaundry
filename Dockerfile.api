FROM node:20-alpine
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
RUN corepack enable && pnpm install --filter api... --frozen-lockfile=false
COPY . .
RUN pnpm --filter @ozlaundry/shared build && pnpm --filter api build
EXPOSE 4000
CMD ["sh", "-c", "pnpm --filter api prisma:generate && pnpm --filter api start"]
